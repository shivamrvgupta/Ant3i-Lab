<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <title>Request Submitted — ANT 3I Lab</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/styles.css" />
</head>
<body class="app-bg">

<nav class="navbar navbar-dark bg-dark px-3 py-2">
  <span class="navbar-brand d-flex align-items-center gap-2">
    <img src="/logo.png" alt="ANT 3I Lab" style="height:32px;object-fit:contain" />
  </span>
  <a href="/login" class="btn btn-sm btn-outline-light">Staff Login</a>
</nav>

<div class="container py-5" style="max-width:640px">
  <div class="card border-0 rounded-4 shadow-sm">
    <div class="card-body p-4">

      <div class="text-center mb-4">
        <div style="font-size:3rem">✅</div>
        <h4 class="fw-bold mt-2">Request Submitted!</h4>
        <div class="text-muted small">A confirmation has been sent to <strong><%= request.email %></strong></div>
      </div>

      <!-- Request summary -->
      <div class="border rounded-3 p-3 mb-3 small">
        <div class="d-flex justify-content-between mb-2">
          <span class="text-muted">Request No.</span>
          <span class="fw-bold font-monospace"><%= request.requestNo %></span>
        </div>
        <div class="d-flex justify-content-between mb-2">
          <span class="text-muted">Name</span>
          <span><%= request.name %></span>
        </div>
        <% if (request.company) { %>
        <div class="d-flex justify-content-between mb-2">
          <span class="text-muted">Company</span>
          <span><%= request.company %></span>
        </div>
        <% } %>
        <% if (request.gstNumber) { %>
        <div class="d-flex justify-content-between mb-2">
          <span class="text-muted">GST Number</span>
          <span class="font-monospace"><%= request.gstNumber %></span>
        </div>
        <% } %>
        <div class="d-flex justify-content-between mb-2">
          <span class="text-muted">Preferred Date</span>
          <span><%= new Date(request.preferredDate).toLocaleDateString('en-IN', { day:'2-digit', month:'short', year:'numeric' }) %></span>
        </div>
        <div class="d-flex justify-content-between mb-2">
          <span class="text-muted">Sample</span>
          <span><%= request.sampleName %></span>
        </div>
      </div>

      <!-- Tests -->
      <div class="section-label mb-2">Selected Tests</div>
      <table class="table table-sm small mb-3">
        <thead class="table-light">
          <tr><th>Test</th><th>Method</th><th class="text-end">Rate</th></tr>
        </thead>
        <tbody>
          <% request.selectedTests.forEach(t => { %>
          <tr>
            <td><%= t.name %></td>
            <td class="text-muted"><%= t.method %></td>
            <td class="text-end">₹<%= t.rate.toLocaleString('en-IN') %></td>
          </tr>
          <% }) %>
        </tbody>
        <tfoot>
          <tr class="table-light">
            <td colspan="2" class="text-muted">Subtotal</td>
            <td class="text-end">₹<%= request.subtotal.toLocaleString('en-IN') %></td>
          </tr>
          <tr class="table-light">
            <td colspan="2" class="text-muted">GST (18%)</td>
            <td class="text-end">₹<%= request.gstAmount.toLocaleString('en-IN') %></td>
          </tr>
          <tr>
            <td colspan="2" class="fw-bold">Total</td>
            <td class="text-end fw-bold">₹<%= request.totalAmount.toLocaleString('en-IN') %></td>
          </tr>
        </tfoot>
      </table>

      <div class="alert alert-info py-2 small mb-3">
        Our team will review your request and send you a confirmation email with further instructions.
      </div>

      <a href="/book" class="btn btn-outline-dark btn-sm w-100">Submit Another Request</a>
    </div>
  </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
