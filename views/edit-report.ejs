<!doctype html>
<html lang="en">
<head><%- include('partials/head') %><title>Edit Report <%= report.reportNo %></title></head>
<body class="app-bg">
<%- include('partials/navbar') %>

<div class="container-xxl py-4">
  <div class="d-flex align-items-center gap-3 mb-4">
    <a href="<%= backUrl %>" class="btn btn-sm btn-outline-secondary">← Back</a>
    <h4 class="fw-bold mb-0">Edit Report</h4>
    <span class="badge bg-secondary font-monospace"><%= report.reportNo %></span>
  </div>

  <% if (error) { %>
    <div class="alert alert-danger py-2 small"><%= error %></div>
  <% } %>

  <form method="POST" action="<%= submitUrl %>">
    <div class="card border-0 rounded-4 shadow-sm mb-3">
      <div class="card-body">

        <!-- ── Basic Details ── -->
        <div class="section-label mt-1">Basic Details</div>

        <div class="position-relative mt-2">
          <label class="form-label small text-muted">Customer</label>
          <input class="form-control" id="customerInput" name="customer"
                 value="<%= vals.customer || '' %>"
                 placeholder="Type to search or add new..." autocomplete="off" required />
          <ul id="customerSuggestions" class="list-group position-absolute w-100 shadow-sm"
              style="z-index:999;display:none;max-height:200px;overflow-y:auto"></ul>
        </div>

        <div class="row g-2 mt-1">
          <div class="col-6 col-md-3">
            <label class="form-label small text-muted">Sample Name</label>
            <input class="form-control" name="sampleName" value="<%= vals.sampleName || 'DIESEL' %>" />
          </div>
          <div class="col-6 col-md-3">
            <label class="form-label small text-muted">Fuel Type</label>
            <select class="form-control" id="fuelTypeSelect" name="fuelType">
              <option value="">— Select Fuel Type —</option>
              <% fuelTypes.forEach(ft => { %>
              <option value="<%= ft.name %>" data-spec="<%= ft.standardRef %>"
                <%= vals.specStd === ft.standardRef ? 'selected' : '' %>>
                <%= ft.name %>
              </option>
              <% }) %>
            </select>
          </div>
          <div class="col-6 col-md-3">
            <label class="form-label small text-muted">Report Date</label>
            <input class="form-control" name="reportDate" type="date" value="<%= vals.reportDate %>" required />
          </div>
          <div class="col-6 col-md-3">
            <label class="form-label small text-muted">Date Received</label>
            <input class="form-control" name="dateReceived" type="date" value="<%= vals.dateReceived %>" />
          </div>
        </div>

        <div class="row g-2 mt-1">
          <div class="col-md-3">
            <label class="form-label small text-muted">Specification</label>
            <input class="form-control" id="specStdInput" name="specStd" value="<%= vals.specStd || 'IS 1460:2017 (BS-VI)' %>" />
          </div>
        </div>

        <div class="row g-2 mt-1">
          <div class="col-6 col-md-4">
            <label class="form-label small text-muted">Sample ID</label>
            <input class="form-control" name="sampleId" value="<%= vals.sampleId || '' %>" placeholder="e.g. Seal No.-001343" />
          </div>
          <div class="col-6 col-md-4">
            <label class="form-label small text-muted">Packing Condition</label>
            <input class="form-control" name="packingCondition" value="<%= vals.packingCondition || '' %>" placeholder="e.g. Unsealed, 1L Aluminum Bottle" />
          </div>
          <div class="col-6 col-md-4">
            <label class="form-label small text-muted">Tested By</label>
            <input class="form-control" value="<%= user.name %>" disabled />
          </div>
        </div>

        <!-- ── Hidden active catalog codes (used by POST to reload correct catalog items) ── -->
        <% catalogItems.forEach(item => { %>
        <input type="hidden" name="activeCodes[]" value="<%= item.code %>" />
        <% }) %>

        <!-- ── Key Results (dynamic from catalog) ── -->
        <div class="section-label mt-4">Key Results</div>
        <div class="row g-2 mt-1">
          <% catalogItems.filter(c => c.code !== '1240' && c.code !== '1241').forEach(item => { %>
          <% (item.fields || []).filter(f => f.fieldName).forEach(f => { %>
          <div class="col-6 col-md-3">
            <label class="form-label small text-muted">
              <%= f.label || item.name %><% if (f.unit && f.unit !== '-') { %> (<%= f.unit %>)<% } %>
            </label>
            <% if (f.specType === 'text' || f.specType === 'visual') { %>
              <input class="form-control" name="<%= f.fieldName %>"
                     value="<%= vals[f.fieldName] !== undefined ? vals[f.fieldName] : (f.specText || '') %>" />
            <% } else { %>
              <input class="form-control" name="<%= f.fieldName %>" type="number" step="any"
                     value="<%= vals[f.fieldName] !== undefined ? vals[f.fieldName] : '' %>" placeholder="—" />
            <% } %>
            <div class="form-text spec-display" data-fieldname="<%= f.fieldName %>" data-method="<%= f.method || item.method %>">
              <% if (f.specType === 'min')   { %>Min. <%= f.specMin %>
              <% } else if (f.specType === 'max')   { %>Max. <%= f.specMax %>
              <% } else if (f.specType === 'range') { %><%= f.specMin %>–<%= f.specMax %>
              <% } else if (f.specType === 'text' || f.specType === 'visual') { %><%= f.specText %>
              <% } %>
              <% const fMethod = f.method || item.method; if (fMethod) { %> · <%= fMethod %><% } %>
            </div>
          </div>
          <% }) %>
          <% }) %>
        </div>

        <!-- ── Distillation ── -->
        <% if (catalogItems.some(c => c.code === '1240')) { %>
        <div class="section-label mt-4">Distillation — Temperatures at % Recovery
          <span class="fw-normal text-muted small ms-1">· ASTM D 1550</span>
        </div>
        <div class="row g-2 mt-1">
          <% [['IBP','d_ibp'],['10%','d_10'],['50%','d_50'],['90%','d_90'],['95% (°C)','d_95'],['FBP','d_fbp']].forEach(([lbl,nm]) => { %>
          <div class="col-4 col-md-2">
            <label class="form-label small text-muted"><%= lbl %></label>
            <input class="form-control" name="<%= nm %>" type="number" step="any"
                   value="<%= vals[nm] !== undefined ? vals[nm] : '' %>" placeholder="—" />
          </div>
          <% }) %>
          <div class="col-4 col-md-2">
            <label class="form-label small text-muted">Recovery %</label>
            <input class="form-control" name="d_recovery" value="<%= vals.d_recovery || '' %>" placeholder="e.g. 97.2" />
          </div>
        </div>
        <div class="section-label mt-3" style="font-size:.75rem;text-transform:none;letter-spacing:0">
          Distillation Summary <span class="fw-normal text-muted ms-1">· ASTM D 86</span>
        </div>
        <div class="row g-2 mt-1">
          <div class="col-4 col-md-2">
            <label class="form-label small text-muted">Residue (%)</label>
            <input class="form-control" name="distResidue" value="<%= vals.distResidue || '' %>" placeholder="e.g. 1.5" />
          </div>
          <div class="col-4 col-md-2">
            <label class="form-label small text-muted">Loss (%)</label>
            <input class="form-control" name="distLoss" value="<%= vals.distLoss || '' %>" placeholder="e.g. 1.3" />
          </div>
        </div>
        <% } %>

        <div class="d-flex gap-2 mt-4">
          <button class="btn btn-dark" type="submit" id="submitBtn">Save Changes</button>
          <a href="<%= backUrl %>" class="btn btn-outline-secondary">Cancel</a>
        </div>
      </div>
    </div>
  </form>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script>
const input = document.getElementById('customerInput');
const list  = document.getElementById('customerSuggestions');
let debounce;
input.addEventListener('input', () => {
  clearTimeout(debounce);
  const q = input.value.trim();
  if (q.length < 1) { list.style.display = 'none'; return; }
  debounce = setTimeout(async () => {
    const res   = await fetch(`/api/customers/search?q=${encodeURIComponent(q)}`);
    const names = await res.json();
    list.innerHTML = '';
    if (!names.length) { list.style.display = 'none'; return; }
    names.forEach(name => {
      const li = document.createElement('li');
      li.className = 'list-group-item list-group-item-action py-1 small';
      li.textContent = name;
      li.addEventListener('mousedown', () => { input.value = name; list.style.display = 'none'; });
      list.appendChild(li);
    });
    list.style.display = 'block';
  }, 250);
});
document.addEventListener('click', e => { if (!input.contains(e.target)) list.style.display = 'none'; });

const fuelTypeSelect = document.getElementById('fuelTypeSelect');
const specStdInput = document.getElementById('specStdInput');

async function updateSpecsForFuelType(fuelTypeName) {
  if (!fuelTypeName) return;

  try {
    const res = await fetch(`/api/fuel-type/${encodeURIComponent(fuelTypeName)}`);
    const data = await res.json();
    const specsMap = data.specs || {};

    // Update all spec displays
    document.querySelectorAll('.spec-display').forEach(elem => {
      const fieldName = elem.dataset.fieldname;
      const method = elem.dataset.method;
      const spec = specsMap[fieldName];

      if (spec) {
        let specText = '';
        if (spec.specType === 'min') {
          specText = `Min. ${spec.specMin}`;
        } else if (spec.specType === 'max') {
          specText = `Max. ${spec.specMax}`;
        } else if (spec.specType === 'range') {
          specText = `${spec.specMin}–${spec.specMax}`;
        } else if (spec.specType === 'text' || spec.specType === 'visual') {
          specText = spec.specText || '';
        }

        if (method) specText += ` · ${method}`;
        elem.textContent = specText;
      }
    });
  } catch (err) {
    console.error('Error fetching fuel type specs:', err);
  }
}

fuelTypeSelect.addEventListener('change', () => {
  const selected = fuelTypeSelect.options[fuelTypeSelect.selectedIndex];
  if (selected && selected.dataset.spec) {
    specStdInput.value = selected.dataset.spec;
  }
  if (fuelTypeSelect.value) {
    updateSpecsForFuelType(fuelTypeSelect.value);
  }
});

document.querySelector('form').addEventListener('submit', () => {
  const btn = document.getElementById('submitBtn');
  btn.disabled = true;
  btn.textContent = 'Saving…';
});
</script>
</body>
</html>
