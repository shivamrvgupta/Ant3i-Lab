<!doctype html>
<html lang="en">
<head><%- include('../partials/head') %><title>Test Catalog — Admin</title></head>
<body class="app-bg">
<%- include('../partials/navbar') %>

<div class="container-xxl py-4">
  <div class="d-flex align-items-center gap-3 mb-4">
    <a href="/admin/dashboard" class="btn btn-sm btn-outline-secondary">← Back</a>
    <h4 class="fw-bold mb-0">Test Catalog</h4>
    <button class="btn btn-dark btn-sm ms-auto" data-bs-toggle="modal" data-bs-target="#addModal">+ Add Test</button>
  </div>

  <% if (error) { %>
    <div class="alert alert-danger py-2 small"><%= error %></div>
  <% } %>
  <% if (success) { %>
    <div class="alert alert-success py-2 small"><%= success %></div>
  <% } %>

  <div class="card border-0 rounded-4 shadow-sm">
    <div class="card-body">
      <% if (tests.length === 0) { %>
        <div class="text-muted small">No tests yet. Click "+ Add Test" to add one.</div>
      <% } else { %>
      <div class="table-responsive">
        <table class="table table-sm table-hover align-middle mb-0">
          <thead class="table-light">
            <tr>
              <th>Code</th>
              <th>Name</th>
              <th>Method</th>
              <th>Fields</th>
              <th class="text-end">Rate (₹)</th>
              <th class="text-end">+GST (₹)</th>
              <th>Status</th>
              <th></th>
            </tr>
          </thead>
          <tbody>
            <% tests.forEach(t => { %>
            <tr class="<%= t.isActive ? '' : 'text-muted' %>">
              <td class="font-monospace small"><%= t.code %></td>
              <td><%= t.name %></td>
              <td class="small text-muted"><%= t.method || '—' %></td>
              <td class="small">
                <% if (!t.fields || !t.fields.length) { %>
                  <span class="text-muted">—</span>
                <% } else { %>
                  <% t.fields.forEach(f => { %>
                    <div class="font-monospace text-muted" style="font-size:0.78rem">
                      <strong><%= f.fieldName %></strong>
                      <% if (f.unit && f.unit !== '-') { %> (<%= f.unit %>)<% } %>
                      <% if (f.specType === 'min')   { %> · Min <%= f.specMin %>
                      <% } else if (f.specType === 'max')   { %> · Max <%= f.specMax %>
                      <% } else if (f.specType === 'range') { %> · <%= f.specMin %>–<%= f.specMax %>
                      <% } else if (f.specType === 'text' || f.specType === 'visual') { %> · "<%= f.specText %>"
                      <% } %>
                    </div>
                  <% }) %>
                <% } %>
              </td>
              <td class="text-end small">₹<%= t.rate.toLocaleString('en-IN') %></td>
              <td class="text-end small text-muted">₹<%= Math.round(t.rate * 1.18).toLocaleString('en-IN') %></td>
              <td>
                <span class="badge <%= t.isActive ? 'bg-success' : 'bg-secondary' %>">
                  <%= t.isActive ? 'Active' : 'Inactive' %>
                </span>
              </td>
              <td class="d-flex gap-1">
                <button class="btn btn-sm btn-outline-secondary"
                  data-bs-toggle="modal" data-bs-target="#editModal"
                  data-id="<%= t._id %>"
                  data-name="<%= t.name %>"
                  data-method="<%= t.method %>"
                  data-testingtype="<%= t.testingType %>"
                  data-rate="<%= t.rate %>"
                  data-fields="<%- JSON.stringify(t.fields || []) %>">Edit</button>
                <form method="POST" action="/admin/catalog/<%= t._id %>/toggle" style="display:inline">
                  <button class="btn btn-sm <%= t.isActive ? 'btn-outline-danger' : 'btn-outline-success' %>" type="submit">
                    <%= t.isActive ? 'Deactivate' : 'Activate' %>
                  </button>
                </form>
              </td>
            </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
      <div class="small text-muted mt-3">
        All rates are exclusive of 18% GST. Inactive tests are hidden from the customer booking form.
      </div>
      <% } %>
    </div>
  </div>
</div>

<!-- Add Test Modal -->
<div class="modal fade" id="addModal" tabindex="-1">
  <div class="modal-dialog modal-lg">
    <div class="modal-content rounded-4">
      <div class="modal-header">
        <h5 class="modal-title">Add New Test</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <form method="POST" action="/admin/catalog">
        <div class="modal-body">
          <div class="row g-2">
            <div class="col-6">
              <label class="form-label small text-muted">Item Code *</label>
              <input class="form-control" name="code" required placeholder="e.g. 1242" />
            </div>
            <div class="col-6">
              <label class="form-label small text-muted">Rate (₹) *</label>
              <input class="form-control" name="rate" type="number" min="0" step="any" required placeholder="e.g. 1200" />
            </div>
            <div class="col-12">
              <label class="form-label small text-muted">Test Name *</label>
              <input class="form-control" name="name" required placeholder="e.g. Ash Content" />
            </div>
            <div class="col-6">
              <label class="form-label small text-muted">Method</label>
              <input class="form-control" name="method" placeholder="e.g. ASTM D 482" />
            </div>
            <div class="col-6">
              <label class="form-label small text-muted">Testing Type</label>
              <input class="form-control" name="testingType" placeholder="e.g. Automatic" />
            </div>

            <div class="col-12 mt-2">
              <hr class="my-1">
              <div class="d-flex align-items-center gap-2 mb-2">
                <div class="small fw-semibold">Report Field Mappings</div>
                <button type="button" class="btn btn-outline-secondary btn-sm ms-auto" onclick="addFieldRow('add')">+ Add Field</button>
              </div>
              <div id="addFieldsContainer"></div>
            </div>
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-outline-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
          <button type="submit" class="btn btn-dark btn-sm">Add Test</button>
        </div>
      </form>
    </div>
  </div>
</div>

<!-- Edit Test Modal -->
<div class="modal fade" id="editModal" tabindex="-1">
  <div class="modal-dialog modal-lg">
    <div class="modal-content rounded-4">
      <div class="modal-header">
        <h5 class="modal-title">Edit Test</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <form method="POST" id="editForm">
        <div class="modal-body">
          <div class="row g-2">
            <div class="col-12">
              <label class="form-label small text-muted">Test Name *</label>
              <input class="form-control" name="name" id="editName" required />
            </div>
            <div class="col-6">
              <label class="form-label small text-muted">Method</label>
              <input class="form-control" name="method" id="editMethod" />
            </div>
            <div class="col-6">
              <label class="form-label small text-muted">Testing Type</label>
              <input class="form-control" name="testingType" id="editTestingType" />
            </div>
            <div class="col-6">
              <label class="form-label small text-muted">Rate (₹) *</label>
              <input class="form-control" name="rate" id="editRate" type="number" min="0" step="any" required />
            </div>

            <div class="col-12 mt-2">
              <hr class="my-1">
              <div class="d-flex align-items-center gap-2 mb-2">
                <div class="small fw-semibold">Report Field Mappings</div>
                <button type="button" class="btn btn-outline-secondary btn-sm ms-auto" onclick="addFieldRow('edit')">+ Add Field</button>
              </div>
              <div id="editFieldsContainer"></div>
            </div>
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-outline-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
          <button type="submit" class="btn btn-dark btn-sm">Save Changes</button>
        </div>
      </form>
    </div>
  </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script>
let addCount = 0;
let editCount = 0;

function fieldRowHTML(prefix, idx, f) {
  f = f || {};
  const st = f.specType || 'none';
  const showMin  = st === 'min' || st === 'range';
  const showMax  = st === 'max' || st === 'range';
  const showText = st === 'text' || st === 'visual';
  return `
    <div class="border rounded-3 p-2 mb-2 position-relative" id="${prefix}FieldRow${idx}">
      <button type="button" class="btn-close position-absolute top-0 end-0 m-1" style="font-size:.6rem"
        onclick="document.getElementById('${prefix}FieldRow${idx}').remove()"></button>
      <div class="row g-2">
        <div class="col-4">
          <label class="form-label small text-muted">Field Key *</label>
          <input class="form-control form-control-sm font-monospace" name="fields[${idx}][fieldName]"
            value="${escHtml(f.fieldName || '')}" placeholder="e.g. visc" required />
        </div>
        <div class="col-4">
          <label class="form-label small text-muted">Label</label>
          <input class="form-control form-control-sm" name="fields[${idx}][label]"
            value="${escHtml(f.label || '')}" placeholder="e.g. Viscosity @ 40°C" />
        </div>
        <div class="col-4">
          <label class="form-label small text-muted">Unit</label>
          <input class="form-control form-control-sm" name="fields[${idx}][unit]"
            value="${escHtml(f.unit || '')}" placeholder="e.g. cSt" />
        </div>
        <div class="col-6">
          <label class="form-label small text-muted">Method (optional override)</label>
          <input class="form-control form-control-sm" name="fields[${idx}][method]"
            value="${escHtml(f.method || '')}" placeholder="e.g. ASTM D 613" />
        </div>
        <div class="col-6">
          <label class="form-label small text-muted">Spec Type</label>
          <select class="form-select form-select-sm" name="fields[${idx}][specType]"
            onchange="toggleFieldSpec(this, '${prefix}', ${idx})">
            ${['none','min','max','range','text','visual'].map(v =>
              `<option value="${v}"${v===st?' selected':''}>${v.charAt(0).toUpperCase()+v.slice(1)}</option>`
            ).join('')}
          </select>
        </div>
        <div class="col-4" id="${prefix}${idx}specMin" style="display:${showMin?'':'none'}">
          <label class="form-label small text-muted">Spec Min</label>
          <input class="form-control form-control-sm" name="fields[${idx}][specMin]"
            type="number" step="any" value="${f.specMin != null ? f.specMin : ''}" />
        </div>
        <div class="col-4" id="${prefix}${idx}specMax" style="display:${showMax?'':'none'}">
          <label class="form-label small text-muted">Spec Max</label>
          <input class="form-control form-control-sm" name="fields[${idx}][specMax]"
            type="number" step="any" value="${f.specMax != null ? f.specMax : ''}" />
        </div>
        <div class="col-8" id="${prefix}${idx}specText" style="display:${showText?'':'none'}">
          <label class="form-label small text-muted">Expected Value</label>
          <input class="form-control form-control-sm" name="fields[${idx}][specText]"
            value="${escHtml(f.specText || '')}" placeholder="e.g. Clear &amp; Bright" />
        </div>
      </div>
    </div>`;
}

function escHtml(s) {
  return String(s).replace(/&/g,'&amp;').replace(/"/g,'&quot;').replace(/</g,'&lt;').replace(/>/g,'&gt;');
}

function toggleFieldSpec(sel, prefix, idx) {
  const v = sel.value;
  const showMin  = v === 'min' || v === 'range';
  const showMax  = v === 'max' || v === 'range';
  const showText = v === 'text' || v === 'visual';
  document.getElementById(`${prefix}${idx}specMin`).style.display  = showMin  ? '' : 'none';
  document.getElementById(`${prefix}${idx}specMax`).style.display  = showMax  ? '' : 'none';
  document.getElementById(`${prefix}${idx}specText`).style.display = showText ? '' : 'none';
}

function addFieldRow(prefix, f) {
  const idx = prefix === 'add' ? addCount++ : editCount++;
  const container = document.getElementById(`${prefix}FieldsContainer`);
  container.insertAdjacentHTML('beforeend', fieldRowHTML(prefix, idx, f || {}));
}

// Reset add modal when opened
document.getElementById('addModal').addEventListener('show.bs.modal', () => {
  addCount = 0;
  document.getElementById('addFieldsContainer').innerHTML = '';
});

// Pre-fill edit modal
document.getElementById('editModal').addEventListener('show.bs.modal', e => {
  const btn = e.relatedTarget;
  document.getElementById('editForm').action       = `/admin/catalog/${btn.dataset.id}/edit`;
  document.getElementById('editName').value        = btn.dataset.name;
  document.getElementById('editMethod').value      = btn.dataset.method || '';
  document.getElementById('editTestingType').value = btn.dataset.testingtype || '';
  document.getElementById('editRate').value        = btn.dataset.rate;

  editCount = 0;
  document.getElementById('editFieldsContainer').innerHTML = '';
  let fields = [];
  try { fields = JSON.parse(btn.dataset.fields || '[]'); } catch(e) {}
  fields.forEach(f => addFieldRow('edit', f));
});
</script>
</body>
</html>
