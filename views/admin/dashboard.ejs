<!doctype html>
<html lang="en">
<head><%- include('../partials/head') %><title>Admin Dashboard</title></head>
<body class="app-bg">
<%- include('../partials/navbar') %>

<div class="container-xxl py-4">
  <h4 class="fw-bold mb-4">Dashboard</h4>

  <!-- Summary Cards -->
  <div class="row g-3 mb-4">
    <div class="col-6 col-md-3">
      <div class="card border-0 rounded-4 shadow-sm text-center py-3">
        <div class="fs-2 fw-bold"><%= totalReports %></div>
        <div class="text-muted small">Total Reports</div>
      </div>
    </div>
    <div class="col-6 col-md-3">
      <div class="card border-0 rounded-4 shadow-sm text-center py-3">
        <div class="fs-2 fw-bold"><%= totalCustomers %></div>
        <div class="text-muted small">Customers</div>
      </div>
    </div>
    <div class="col-6 col-md-3">
      <div class="card border-0 rounded-4 shadow-sm text-center py-3">
        <div class="fs-2 fw-bold"><%= totalEmployees %></div>
        <div class="text-muted small">Employees</div>
      </div>
    </div>
    <div class="col-6 col-md-3">
      <a href="/admin/requests" class="card border-0 rounded-4 shadow-sm text-center py-3 text-decoration-none
         <%= pendingRequests > 0 ? 'bg-warning' : '' %>">
        <div class="fs-2 fw-bold"><%= pendingRequests %></div>
        <div class="small <%= pendingRequests > 0 ? 'text-dark fw-semibold' : 'text-muted' %>">Pending Requests</div>
      </a>
    </div>
  </div>

  <!-- Quick Links -->
  <div class="d-flex flex-wrap gap-2 mb-4">
    <a href="/admin/employees" class="btn btn-dark btn-sm">Manage Employees</a>
    <a href="/admin/reports"   class="btn btn-outline-dark btn-sm">All Reports</a>
    <a href="/admin/requests"  class="btn btn-outline-dark btn-sm">Booking Requests</a>
    <a href="/admin/catalog"    class="btn btn-outline-dark btn-sm">Test Catalog</a>
    <a href="/admin/fuel-types" class="btn btn-outline-dark btn-sm">Fuel Types</a>
    <a href="/admin/customers"  class="btn btn-outline-dark btn-sm">Customers</a>
  </div>

  <!-- Tabbed section: Recent Reports | Booking Requests -->
  <div class="card border-0 rounded-4 shadow-sm">
    <div class="card-body">
      <ul class="nav nav-tabs mb-3" id="dashTabs" role="tablist">
        <li class="nav-item" role="presentation">
          <button class="nav-link active" id="reports-tab" data-bs-toggle="tab" data-bs-target="#reportsPane"
            type="button" role="tab">Recent Reports</button>
        </li>
        <li class="nav-item" role="presentation">
          <button class="nav-link" id="requests-tab" data-bs-toggle="tab" data-bs-target="#requestsPane"
            type="button" role="tab">
            Booking Requests
            <% if (pendingRequests > 0) { %>
            <span class="badge bg-warning text-dark ms-1"><%= pendingRequests %></span>
            <% } %>
          </button>
        </li>
      </ul>

      <div class="tab-content" id="dashTabContent">

        <!-- Recent Reports Tab -->
        <div class="tab-pane fade show active" id="reportsPane" role="tabpanel">
          <% if (recentReports.length === 0) { %>
            <div class="text-muted small">No reports yet.</div>
          <% } else { %>
          <div class="table-responsive">
            <table class="table table-sm table-hover align-middle mb-0">
              <thead class="table-light">
                <tr>
                  <th>Report No.</th><th>Customer</th><th>Sample</th>
                  <th>Created By</th><th>Status</th><th>Date</th><th></th>
                </tr>
              </thead>
              <tbody>
                <% recentReports.forEach(r => { %>
                <tr>
                  <td class="font-monospace small"><%= r.reportNo %></td>
                  <td><%= r.customer %></td>
                  <td><%= r.sampleName %></td>
                  <td><%= r.createdBy?.name || '—' %></td>
                  <td>
                    <span class="badge <%= r.overallStatus === 'NORMAL' ? 'bg-success' : 'bg-danger' %>">
                      <%= r.overallStatus %>
                    </span>
                  </td>
                  <td class="small text-muted"><%= new Date(r.createdAt).toLocaleDateString('en-IN') %></td>
                  <td><a href="/admin/reports/<%= r._id %>" class="btn btn-sm btn-outline-secondary">View</a></td>
                </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
          <a href="/admin/reports" class="btn btn-sm btn-outline-dark mt-3">View all reports →</a>
          <% } %>
        </div>

        <!-- Booking Requests Tab -->
        <div class="tab-pane fade" id="requestsPane" role="tabpanel">
          <% if (recentRequests.length === 0) { %>
            <div class="text-muted small">No booking requests yet.</div>
          <% } else { %>
          <div class="table-responsive">
            <table class="table table-sm table-hover align-middle mb-0">
              <thead class="table-light">
                <tr>
                  <th>Req No.</th><th>Customer</th><th>Sample</th>
                  <th>Tests</th><th>Preferred Date</th><th>Amount</th><th>Status</th><th></th>
                </tr>
              </thead>
              <tbody>
                <% recentRequests.forEach(req => { %>
                <tr>
                  <td class="font-monospace small"><%= req.requestNo %></td>
                  <td>
                    <div class="fw-medium"><%= req.name %></div>
                    <% if (req.company) { %><div class="text-muted small"><%= req.company %></div><% } %>
                  </td>
                  <td class="small"><%= req.sampleName %></td>
                  <td class="small text-muted"><%= req.selectedTests.length %> test(s)</td>
                  <td class="small"><%= new Date(req.preferredDate).toLocaleDateString('en-IN') %></td>
                  <td class="small fw-medium">₹<%= req.totalAmount.toLocaleString('en-IN') %></td>
                  <td>
                    <span class="badge <%=
                      req.status === 'accepted' ? 'bg-success' :
                      req.status === 'rejected' ? 'bg-secondary' : 'bg-warning text-dark'
                    %>"><%= req.status %></span>
                  </td>
                  <td>
                    <div class="d-flex gap-1">
                      <% if (req.status === 'pending') { %>
                      <form method="POST" action="/admin/requests/<%= req._id %>/accept" style="display:inline">
                        <button class="btn btn-sm btn-success" type="submit">Accept</button>
                      </form>
                      <% } %>
                      <a href="/admin/requests" class="btn btn-sm btn-outline-secondary">View</a>
                    </div>
                  </td>
                </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
          <a href="/admin/requests" class="btn btn-sm btn-outline-dark mt-3">View all requests →</a>
          <% } %>
        </div>

      </div>
    </div>
  </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
