<!doctype html>
<html lang="en">
<head><%- include('../partials/head') %><title>Admin Dashboard</title></head>
<body class="app-bg">
<%- include('../partials/navbar') %>

<div class="container-xxl py-4">
  <h4 class="fw-bold mb-4">Dashboard</h4>

  <!-- Summary Cards -->
  <div class="row g-3 mb-4">
    <div class="col-6 col-md-4">
      <div class="card border-0 rounded-4 shadow-sm text-center py-3">
        <div class="fs-2 fw-bold"><%= totalReports %></div>
        <div class="text-muted small">Total Reports</div>
      </div>
    </div>
    <div class="col-6 col-md-4">
      <div class="card border-0 rounded-4 shadow-sm text-center py-3">
        <div class="fs-2 fw-bold"><%= totalCustomers %></div>
        <div class="text-muted small">Customers</div>
      </div>
    </div>
    <div class="col-6 col-md-4">
      <div class="card border-0 rounded-4 shadow-sm text-center py-3">
        <div class="fs-2 fw-bold"><%= totalEmployees %></div>
        <div class="text-muted small">Employees</div>
      </div>
    </div>
  </div>

  <!-- Quick Links -->
  <div class="d-flex flex-wrap gap-2 mb-4">
    <a href="/admin/employees" class="btn btn-dark btn-sm">Manage Employees</a>
    <a href="/admin/reports"   class="btn btn-outline-dark btn-sm">All Reports</a>
    <a href="/admin/customers" class="btn btn-outline-dark btn-sm">Customers</a>
  </div>

  <!-- Recent Reports -->
  <div class="card border-0 rounded-4 shadow-sm">
    <div class="card-body">
      <div class="section-label mb-3">Recent Reports</div>
      <% if (recentReports.length === 0) { %>
        <div class="text-muted small">No reports yet.</div>
      <% } else { %>
      <div class="table-responsive">
        <table class="table table-sm table-hover align-middle mb-0">
          <thead class="table-light">
            <tr>
              <th>Report No.</th>
              <th>Customer</th>
              <th>Sample</th>
              <th>Created By</th>
              <th>Status</th>
              <th>Date</th>
              <th></th>
            </tr>
          </thead>
          <tbody>
            <% recentReports.forEach(r => { %>
            <tr>
              <td class="font-monospace small"><%= r.reportNo %></td>
              <td><%= r.customer %></td>
              <td><%= r.sampleName %></td>
              <td><%= r.createdBy?.name || '—' %></td>
              <td>
                <span class="badge <%= r.overallStatus === 'NORMAL' ? 'bg-success' : 'bg-danger' %>">
                  <%= r.overallStatus %>
                </span>
              </td>
              <td class="small text-muted"><%= new Date(r.createdAt).toLocaleDateString('en-IN') %></td>
              <td><a href="/admin/reports/<%= r._id %>" class="btn btn-sm btn-outline-secondary">View</a></td>
            </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
      <% } %>
    </div>
  </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
