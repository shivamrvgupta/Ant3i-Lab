<!doctype html>
<html lang="en">
<head><%- include('../partials/head') %><title>Customers — Admin</title></head>
<body class="app-bg">
<%- include('../partials/navbar') %>

<div class="container-xxl py-4">
  <div class="d-flex align-items-center gap-3 mb-4">
    <a href="/admin/dashboard" class="btn btn-sm btn-outline-secondary">← Back</a>
    <h4 class="fw-bold mb-0">Customers (<%= customers.length %>)</h4>
  </div>

  <div class="card border-0 rounded-4 shadow-sm">
    <div class="card-body">
      <% if (customers.length === 0) { %>
        <div class="text-muted small">No customers yet. They are created automatically when employees generate reports.</div>
      <% } else { %>
      <div class="table-responsive">
        <table class="table table-sm table-hover align-middle mb-0">
          <thead class="table-light">
            <tr><th>#</th><th>Customer Name</th><th>Added</th></tr>
          </thead>
          <tbody>
            <% customers.forEach((c, i) => { %>
            <tr>
              <td class="text-muted small"><%= i + 1 %></td>
              <td><%= c.name %></td>
              <td class="small text-muted"><%= new Date(c.createdAt).toLocaleDateString('en-IN') %></td>
            </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
      <% } %>
    </div>
  </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
