<!doctype html>
<html lang="en">
<head><%- include('../partials/head') %><title>Employees — Admin</title></head>
<body class="app-bg">
<%- include('../partials/navbar') %>

<div class="container-xxl py-4">
  <div class="d-flex align-items-center gap-3 mb-4">
    <a href="/admin/dashboard" class="btn btn-sm btn-outline-secondary">← Back</a>
    <h4 class="fw-bold mb-0">Employees</h4>
  </div>

  <div class="row g-4">
    <!-- Create Employee -->
    <div class="col-12 col-md-4">
      <div class="card border-0 rounded-4 shadow-sm">
        <div class="card-body">
          <div class="section-label mb-3">Add New Employee</div>

          <% if (error)   { %><div class="alert alert-danger   py-2 small"><%= error   %></div><% } %>
          <% if (success) { %><div class="alert alert-success  py-2 small"><%= success %></div><% } %>

          <form method="POST" action="/admin/employees">
            <div class="mb-2">
              <label class="form-label small text-muted">Full Name</label>
              <input class="form-control" name="name" required placeholder="John Doe" />
            </div>
            <div class="mb-2">
              <label class="form-label small text-muted">Email</label>
              <input class="form-control" type="email" name="email" required placeholder="john@lab.com" />
            </div>
            <div class="mb-3">
              <label class="form-label small text-muted">Password</label>
              <input class="form-control" type="password" name="password" required minlength="6" placeholder="Min 6 chars" />
            </div>
            <button class="btn btn-dark w-100" type="submit">Create Employee</button>
          </form>
        </div>
      </div>
    </div>

    <!-- Employee List -->
    <div class="col-12 col-md-8">
      <div class="card border-0 rounded-4 shadow-sm">
        <div class="card-body">
          <div class="section-label mb-3">All Employees (<%= employees.length %>)</div>
          <% if (employees.length === 0) { %>
            <div class="text-muted small">No employees yet.</div>
          <% } else { %>
          <div class="table-responsive">
            <table class="table table-sm table-hover align-middle mb-0">
              <thead class="table-light">
                <tr><th>Name</th><th>Email</th><th>Status</th><th>Created</th><th></th></tr>
              </thead>
              <tbody>
                <% employees.forEach(emp => { %>
                <tr>
                  <td><%= emp.name %></td>
                  <td class="small text-muted"><%= emp.email %></td>
                  <td>
                    <span class="badge <%= emp.isActive ? 'bg-success' : 'bg-secondary' %>">
                      <%= emp.isActive ? 'Active' : 'Inactive' %>
                    </span>
                  </td>
                  <td class="small text-muted"><%= new Date(emp.createdAt).toLocaleDateString('en-IN') %></td>
                  <td>
                    <form method="POST" action="/admin/employees/<%= emp._id %>/toggle" style="display:inline">
                      <button class="btn btn-sm <%= emp.isActive ? 'btn-outline-danger' : 'btn-outline-success' %>" type="submit">
                        <%= emp.isActive ? 'Deactivate' : 'Activate' %>
                      </button>
                    </form>
                  </td>
                </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
          <% } %>
        </div>
      </div>
    </div>
  </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
