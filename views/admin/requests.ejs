<!doctype html>
<html lang="en">
<head><%- include('../partials/head') %><title>Booking Requests — Admin</title></head>
<body class="app-bg">
<%- include('../partials/navbar') %>

<div class="container-xxl py-4">
  <div class="d-flex align-items-center gap-3 mb-4">
    <a href="/admin/dashboard" class="btn btn-sm btn-outline-secondary">← Back</a>
    <h4 class="fw-bold mb-0">Booking Requests</h4>
    <span class="badge bg-warning text-dark">
      <%= requests.filter(r => r.status === 'pending').length %> Pending
    </span>
  </div>

  <div class="card border-0 rounded-4 shadow-sm">
    <div class="card-body">
      <% if (requests.length === 0) { %>
        <div class="text-muted small">No booking requests yet.</div>
      <% } else { %>
      <div class="table-responsive">
        <table class="table table-sm table-hover align-middle mb-0">
          <thead class="table-light">
            <tr>
              <th>Req No.</th>
              <th>Customer</th>
              <th>Phone</th>
              <th>Tests</th>
              <th>Date</th>
              <th>GST</th>
              <th>Amount</th>
              <th>Status</th>
              <th>Report</th>
              <th></th>
            </tr>
          </thead>
          <tbody>
            <% requests.forEach(r => { %>
            <tr>
              <td class="font-monospace small"><%= r.requestNo %></td>
              <td>
                <div class="fw-semibold small"><%= r.name %></div>
                <% if (r.company) { %><div class="text-muted" style="font-size:.75rem"><%= r.company %></div><% } %>
                <div class="text-muted" style="font-size:.72rem"><%= r.email %></div>
                <% if (r.gstNumber) { %><div class="text-muted font-monospace" style="font-size:.7rem">GSTIN: <%= r.gstNumber %></div><% } %>
              </td>
              <td class="small text-muted"><%= r.phone %></td>
              <td class="small">
                <% r.selectedTests.forEach(t => { %>
                  <div class="text-muted" style="font-size:.72rem"><%= t.name %></div>
                <% }) %>
              </td>
              <td class="small"><%= new Date(r.preferredDate).toLocaleDateString('en-IN', { day:'2-digit', month:'short', year:'numeric' }) %></td>
              <td class="small text-muted">₹<%= r.gstAmount.toLocaleString('en-IN') %></td>
              <td class="small">
                <div>₹<%= r.totalAmount.toLocaleString('en-IN') %></div>
                <form method="POST" action="/admin/requests/<%= r._id %>/payment-toggle" style="display:inline">
                  <button class="btn px-1 py-0 mt-1 <%= r.paymentStatus === 'paid' ? 'btn-success' : 'btn-outline-warning' %>"
                    style="font-size:.7rem" type="submit">
                    <%= r.paymentStatus === 'paid' ? '✓ Paid' : 'Unpaid' %>
                  </button>
                </form>
              </td>
              <td>
                <span class="badge <%=
                  r.status === 'pending'  ? 'bg-warning text-dark' :
                  r.status === 'accepted' ? 'bg-success' : 'bg-danger'
                %>"><%= r.status.charAt(0).toUpperCase() + r.status.slice(1) %></span>
                <% if (r.status === 'rejected' && r.rejectionNote) { %>
                  <div class="text-muted" style="font-size:.72rem"><%= r.rejectionNote %></div>
                <% } %>
              </td>
              <td class="d-flex flex-column gap-1">
                <% if (r.reportId) { %>
                  <a href="/admin/reports/<%= r.reportId %>" class="btn btn-sm btn-outline-secondary">Report</a>
                <% } %>
                <a href="/admin/requests/<%= r._id %>/invoice" class="btn btn-sm btn-outline-dark" target="_blank">Invoice</a>
              </td>
              <td class="d-flex gap-1">
                <% if (r.status === 'pending') { %>
                  <form method="POST" action="/admin/requests/<%= r._id %>/accept" style="display:inline">
                    <button class="btn btn-sm btn-success" type="submit">Accept</button>
                  </form>
                  <button class="btn btn-sm btn-outline-danger"
                    data-bs-toggle="modal" data-bs-target="#rejectModal"
                    data-id="<%= r._id %>" data-name="<%= r.name %>">Reject</button>
                <% } %>
              </td>
            </tr>
            <% }) %>
          </tbody>
        </table>
      </div>

      <!-- Pagination -->
      <% if (totalPages > 1) { %>
      <div class="d-flex gap-2 mt-3 justify-content-end">
        <% for (let p = 1; p <= totalPages; p++) { %>
          <a href="?page=<%= p %>" class="btn btn-sm <%= p === page ? 'btn-dark' : 'btn-outline-secondary' %>"><%= p %></a>
        <% } %>
      </div>
      <% } %>
      <% } %>
    </div>
  </div>
</div>

<!-- Reject Modal -->
<div class="modal fade" id="rejectModal" tabindex="-1">
  <div class="modal-dialog">
    <div class="modal-content rounded-4">
      <div class="modal-header">
        <h5 class="modal-title">Reject Request</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <form method="POST" id="rejectForm">
        <div class="modal-body">
          <p class="small text-muted">Rejecting request from <strong id="rejectName"></strong>.</p>
          <label class="form-label small">Reason (optional)</label>
          <textarea class="form-control" name="rejectionNote" rows="3" placeholder="e.g. Lab unavailable on that date"></textarea>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-outline-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
          <button type="submit" class="btn btn-danger btn-sm">Confirm Reject</button>
        </div>
      </form>
    </div>
  </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script>
document.getElementById('rejectModal').addEventListener('show.bs.modal', e => {
  const btn = e.relatedTarget;
  document.getElementById('rejectForm').action = `/admin/requests/${btn.dataset.id}/reject`;
  document.getElementById('rejectName').textContent = btn.dataset.name;
});
</script>
</body>
</html>
