<!doctype html>
<html lang="en">
<head><%- include('../partials/head') %><title>Fuel Types — Admin</title></head>
<body class="app-bg">
<%- include('../partials/navbar') %>

<div class="container-xxl py-4">
  <div class="d-flex align-items-center gap-3 mb-4">
    <a href="/admin/dashboard" class="btn btn-sm btn-outline-secondary">← Back</a>
    <h4 class="fw-bold mb-0">Fuel / Product Types</h4>
    <button class="btn btn-dark btn-sm ms-auto" data-bs-toggle="modal" data-bs-target="#addModal">+ Add Type</button>
  </div>

  <% if (error) { %>
    <div class="alert alert-danger py-2 small"><%= error %></div>
  <% } %>
  <% if (success) { %>
    <div class="alert alert-success py-2 small"><%= success %></div>
  <% } %>

  <div class="card border-0 rounded-4 shadow-sm">
    <div class="card-body">
      <% if (fuelTypes.length === 0) { %>
        <div class="text-muted small">No fuel types yet. Click "+ Add Type" to add one.</div>
      <% } else { %>
      <div class="table-responsive">
        <table class="table table-sm table-hover align-middle mb-0">
          <thead class="table-light">
            <tr>
              <th>Name</th>
              <th>Standard Ref.</th>
              <th>Spec Overrides</th>
              <th>Status</th>
              <th></th>
            </tr>
          </thead>
          <tbody>
            <% fuelTypes.forEach(ft => { %>
            <tr class="<%= ft.isActive ? '' : 'text-muted' %>">
              <td class="fw-medium"><%= ft.name %></td>
              <td class="small text-muted"><%= ft.standardRef || '—' %></td>
              <td class="small">
                <% if (!ft.specs || !ft.specs.length) { %>
                  <span class="text-muted">—</span>
                <% } else { %>
                  <% ft.specs.forEach(s => { %>
                    <div class="font-monospace text-muted" style="font-size:0.78rem">
                      <strong><%= s.fieldName %></strong>:
                      <% if (s.specType === 'min')   { %>Min <%= s.specMin %>
                      <% } else if (s.specType === 'max')   { %>Max <%= s.specMax %>
                      <% } else if (s.specType === 'range') { %><%= s.specMin %>–<%= s.specMax %>
                      <% } else if (s.specType === 'text' || s.specType === 'visual') { %>"<%= s.specText %>"
                      <% } else { %><%= s.specType %>
                      <% } %>
                    </div>
                  <% }) %>
                <% } %>
              </td>
              <td>
                <span class="badge <%= ft.isActive ? 'bg-success' : 'bg-secondary' %>">
                  <%= ft.isActive ? 'Active' : 'Inactive' %>
                </span>
              </td>
              <td class="d-flex gap-1">
                <button class="btn btn-sm btn-outline-secondary"
                  data-bs-toggle="modal" data-bs-target="#editModal"
                  data-id="<%= ft._id %>"
                  data-name="<%= ft.name %>"
                  data-standardref="<%= ft.standardRef %>"
                  data-specs="<%- JSON.stringify(ft.specs || []) %>">Edit</button>
                <form method="POST" action="/admin/fuel-types/<%= ft._id %>/toggle" style="display:inline">
                  <button class="btn btn-sm <%= ft.isActive ? 'btn-outline-danger' : 'btn-outline-success' %>" type="submit">
                    <%= ft.isActive ? 'Deactivate' : 'Activate' %>
                  </button>
                </form>
              </td>
            </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
      <% } %>
    </div>
  </div>
</div>

<!-- Add Modal -->
<div class="modal fade" id="addModal" tabindex="-1">
  <div class="modal-dialog modal-lg">
    <div class="modal-content rounded-4">
      <div class="modal-header">
        <h5 class="modal-title">Add Fuel / Product Type</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <form method="POST" action="/admin/fuel-types">
        <div class="modal-body">
          <div class="row g-2">
            <div class="col-7">
              <label class="form-label small text-muted">Name *</label>
              <input class="form-control" name="name" required placeholder="e.g. BS-VI Diesel (10 ppm)" />
            </div>
            <div class="col-5">
              <label class="form-label small text-muted">Standard Reference</label>
              <input class="form-control" name="standardRef" placeholder="e.g. IS 1460:2017" />
            </div>

            <div class="col-12 mt-2">
              <hr class="my-1">
              <div class="d-flex align-items-center gap-2 mb-2">
                <div class="small fw-semibold">Spec Overrides</div>
                <span class="text-muted small">(per field key)</span>
                <button type="button" class="btn btn-outline-secondary btn-sm ms-auto" onclick="addSpecRow('add')">+ Add Field</button>
              </div>
              <div id="addSpecsContainer"></div>
            </div>
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-outline-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
          <button type="submit" class="btn btn-dark btn-sm">Add Type</button>
        </div>
      </form>
    </div>
  </div>
</div>

<!-- Edit Modal -->
<div class="modal fade" id="editModal" tabindex="-1">
  <div class="modal-dialog modal-lg">
    <div class="modal-content rounded-4">
      <div class="modal-header">
        <h5 class="modal-title">Edit Fuel / Product Type</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <form method="POST" id="editForm">
        <div class="modal-body">
          <div class="row g-2">
            <div class="col-7">
              <label class="form-label small text-muted">Name *</label>
              <input class="form-control" name="name" id="editName" required />
            </div>
            <div class="col-5">
              <label class="form-label small text-muted">Standard Reference</label>
              <input class="form-control" name="standardRef" id="editStandardRef" />
            </div>

            <div class="col-12 mt-2">
              <hr class="my-1">
              <div class="d-flex align-items-center gap-2 mb-2">
                <div class="small fw-semibold">Spec Overrides</div>
                <span class="text-muted small">(per field key)</span>
                <button type="button" class="btn btn-outline-secondary btn-sm ms-auto" onclick="addSpecRow('edit')">+ Add Field</button>
              </div>
              <div id="editSpecsContainer"></div>
            </div>
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-outline-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
          <button type="submit" class="btn btn-dark btn-sm">Save Changes</button>
        </div>
      </form>
    </div>
  </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script>
let addSpecCount = 0;
let editSpecCount = 0;

function escHtml(s) {
  return String(s || '').replace(/&/g,'&amp;').replace(/"/g,'&quot;').replace(/</g,'&lt;').replace(/>/g,'&gt;');
}

function specRowHTML(prefix, idx, s) {
  s = s || {};
  const st = s.specType || 'none';
  const showMin  = st === 'min'  || st === 'range';
  const showMax  = st === 'max'  || st === 'range';
  const showText = st === 'text' || st === 'visual';
  return `
    <div class="border rounded-3 p-2 mb-2 position-relative" id="${prefix}SpecRow${idx}">
      <button type="button" class="btn-close position-absolute top-0 end-0 m-1" style="font-size:.6rem"
        onclick="document.getElementById('${prefix}SpecRow${idx}').remove()"></button>
      <div class="row g-2">
        <div class="col-4">
          <label class="form-label small text-muted">Field Key *</label>
          <input class="form-control form-control-sm font-monospace" name="specs[${idx}][fieldName]"
            value="${escHtml(s.fieldName)}" placeholder="e.g. sulphur" required />
        </div>
        <div class="col-4">
          <label class="form-label small text-muted">Spec Type</label>
          <select class="form-select form-select-sm" name="specs[${idx}][specType]"
            onchange="toggleSpec(this,'${prefix}',${idx})">
            ${['none','min','max','range','text','visual'].map(v =>
              `<option value="${v}"${v===st?' selected':''}>${v.charAt(0).toUpperCase()+v.slice(1)}</option>`
            ).join('')}
          </select>
        </div>
        <div class="col-4" id="${prefix}${idx}sMin" style="display:${showMin?'':'none'}">
          <label class="form-label small text-muted">Min</label>
          <input class="form-control form-control-sm" name="specs[${idx}][specMin]"
            type="number" step="any" value="${s.specMin != null ? s.specMin : ''}" />
        </div>
        <div class="col-4" id="${prefix}${idx}sMax" style="display:${showMax?'':'none'}">
          <label class="form-label small text-muted">Max</label>
          <input class="form-control form-control-sm" name="specs[${idx}][specMax]"
            type="number" step="any" value="${s.specMax != null ? s.specMax : ''}" />
        </div>
        <div class="col-8" id="${prefix}${idx}sText" style="display:${showText?'':'none'}">
          <label class="form-label small text-muted">Expected Value</label>
          <input class="form-control form-control-sm" name="specs[${idx}][specText]"
            value="${escHtml(s.specText)}" />
        </div>
      </div>
    </div>`;
}

function toggleSpec(sel, prefix, idx) {
  const v = sel.value;
  document.getElementById(`${prefix}${idx}sMin`).style.display  = (v==='min'||v==='range')  ? '' : 'none';
  document.getElementById(`${prefix}${idx}sMax`).style.display  = (v==='max'||v==='range')  ? '' : 'none';
  document.getElementById(`${prefix}${idx}sText`).style.display = (v==='text'||v==='visual') ? '' : 'none';
}

function addSpecRow(prefix, s) {
  const idx = prefix === 'add' ? addSpecCount++ : editSpecCount++;
  document.getElementById(`${prefix}SpecsContainer`).insertAdjacentHTML('beforeend', specRowHTML(prefix, idx, s || {}));
}

document.getElementById('addModal').addEventListener('show.bs.modal', () => {
  addSpecCount = 0;
  document.getElementById('addSpecsContainer').innerHTML = '';
});

document.getElementById('editModal').addEventListener('show.bs.modal', e => {
  const btn = e.relatedTarget;
  document.getElementById('editForm').action    = `/admin/fuel-types/${btn.dataset.id}/edit`;
  document.getElementById('editName').value     = btn.dataset.name;
  document.getElementById('editStandardRef').value = btn.dataset.standardref || '';

  editSpecCount = 0;
  document.getElementById('editSpecsContainer').innerHTML = '';
  let specs = [];
  try { specs = JSON.parse(btn.dataset.specs || '[]'); } catch(e) {}
  specs.forEach(s => addSpecRow('edit', s));
});
</script>
</body>
</html>
