<!doctype html>
<html lang="en">
<head><%- include('../partials/head') %><title>All Reports — Admin</title></head>
<body class="app-bg">
<%- include('../partials/navbar') %>

<div class="container-xxl py-4">
  <div class="d-flex align-items-center gap-3 mb-4">
    <a href="/admin/dashboard" class="btn btn-sm btn-outline-secondary">← Back</a>
    <h4 class="fw-bold mb-0">All Reports</h4>
  </div>

  <div class="card border-0 rounded-4 shadow-sm">
    <div class="card-body">
      <% if (reports.length === 0) { %>
        <div class="text-muted small">No reports yet.</div>
      <% } else { %>
      <div class="table-responsive">
        <table class="table table-sm table-hover align-middle mb-0">
          <thead class="table-light">
            <tr>
              <th>Report No.</th>
              <th>Customer</th>
              <th>Sample</th>
              <th>Created By</th>
              <th>Status</th>
              <th>Fails</th>
              <th>Date</th>
              <th></th>
            </tr>
          </thead>
          <tbody>
            <% reports.forEach(r => { %>
            <tr>
              <td class="font-monospace small"><%= r.reportNo %></td>
              <td><%= r.customer %></td>
              <td><%= r.sampleName %></td>
              <td><%= r.createdBy?.name || '—' %></td>
              <td>
                <span class="badge <%= r.overallStatus === 'NORMAL' ? 'bg-success' : 'bg-danger' %>">
                  <%= r.overallStatus %>
                </span>
              </td>
              <td class="text-center"><%= r.failCount %></td>
              <td class="small text-muted"><%= new Date(r.createdAt).toLocaleDateString('en-IN') %></td>
              <td class="d-flex gap-1">
                <a href="/admin/reports/<%= r._id %>" class="btn btn-sm btn-outline-secondary">View</a>
                <a href="/admin/reports/<%= r._id %>/edit" class="btn btn-sm btn-outline-warning">Edit</a>
              </td>
            </tr>
            <% }) %>
          </tbody>
        </table>
      </div>

      <!-- Pagination -->
      <% if (totalPages > 1) { %>
      <div class="d-flex gap-2 mt-3 justify-content-end">
        <% for (let p = 1; p <= totalPages; p++) { %>
          <a href="?page=<%= p %>" class="btn btn-sm <%= p === page ? 'btn-dark' : 'btn-outline-secondary' %>"><%= p %></a>
        <% } %>
      </div>
      <% } %>
      <% } %>
    </div>
  </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
