<!doctype html>
<html lang="en">
<head><%- include('../partials/head') %><title>Dashboard — Employee</title></head>
<body class="app-bg">
<%- include('../partials/navbar') %>

<div class="container-xxl py-4">
  <div class="d-flex align-items-center justify-content-between mb-4">
    <h4 class="fw-bold mb-0">Welcome, <%= user.name %></h4>
    <a href="/employee/reports/new" class="btn btn-dark btn-sm">+ New Report</a>
  </div>

  <!-- Stats Cards -->
  <div class="row g-3 mb-4">
    <div class="col-6 col-md-3">
      <div class="card border-0 rounded-4 shadow-sm text-center py-3">
        <div class="fs-2 fw-bold"><%= myReportCount %></div>
        <div class="text-muted small">My Reports</div>
      </div>
    </div>
    <div class="col-6 col-md-3">
      <a href="/employee/requests" class="card border-0 rounded-4 shadow-sm text-center py-3 text-decoration-none <%= pendingCount > 0 ? 'bg-warning' : '' %>">
        <div class="fs-2 fw-bold"><%= pendingCount %></div>
        <div class="small <%= pendingCount > 0 ? 'text-dark fw-semibold' : 'text-muted' %>">Pending Requests</div>
      </a>
    </div>
  </div>

  <!-- Pending Booking Requests -->
  <% if (pendingRequests.length > 0) { %>
  <div class="card border-0 rounded-4 shadow-sm mb-4">
    <div class="card-body">
      <div class="d-flex align-items-center justify-content-between mb-3">
        <div class="section-label mb-0">Pending Booking Requests</div>
        <a href="/employee/requests" class="btn btn-sm btn-outline-dark">View All →</a>
      </div>
      <div class="table-responsive">
        <table class="table table-sm table-hover align-middle mb-0">
          <thead class="table-light">
            <tr>
              <th>Req No.</th>
              <th>Customer</th>
              <th>Sample</th>
              <th>Tests</th>
              <th>Preferred Date</th>
              <th>Amount</th>
              <th></th>
            </tr>
          </thead>
          <tbody>
            <% pendingRequests.forEach(req => { %>
            <tr>
              <td class="font-monospace small"><%= req.requestNo %></td>
              <td>
                <div class="fw-medium"><%= req.name %></div>
                <% if (req.company) { %><div class="text-muted small"><%= req.company %></div><% } %>
              </td>
              <td class="small"><%= req.sampleName %></td>
              <td class="small text-muted"><%= req.selectedTests.length %> test(s)</td>
              <td class="small"><%= new Date(req.preferredDate).toLocaleDateString('en-IN') %></td>
              <td class="small fw-medium">₹<%= req.totalAmount.toLocaleString('en-IN') %></td>
              <td>
                <div class="d-flex gap-1">
                  <form method="POST" action="/employee/requests/<%= req._id %>/accept" style="display:inline">
                    <button class="btn btn-sm btn-success" type="submit">Accept</button>
                  </form>
                  <form method="POST" action="/employee/requests/<%= req._id %>/reject" style="display:inline">
                    <button class="btn btn-sm btn-outline-danger" type="submit">Reject</button>
                  </form>
                </div>
              </td>
            </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
  <% } %>

  <!-- Recent Reports -->
  <div class="card border-0 rounded-4 shadow-sm">
    <div class="card-body">
      <div class="section-label mb-3">My Recent Reports</div>
      <% if (recentReports.length === 0) { %>
        <div class="text-muted small">No reports yet. Click <a href="/employee/reports/new">New Report</a> to get started.</div>
      <% } else { %>
      <div class="table-responsive">
        <table class="table table-sm table-hover align-middle mb-0">
          <thead class="table-light">
            <tr><th>Report No.</th><th>Customer</th><th>Sample</th><th>Status</th><th>Payment</th><th>Date</th><th></th></tr>
          </thead>
          <tbody>
            <% recentReports.forEach(r => { %>
            <tr>
              <td class="font-monospace small"><%= r.reportNo %></td>
              <td><%= r.customer %></td>
              <td><%= r.sampleName %></td>
              <td>
                <span class="badge <%= r.overallStatus === 'NORMAL' ? 'bg-success' : 'bg-danger' %>">
                  <%= r.overallStatus %>
                </span>
              </td>
              <% const reqId = invoiceLinkByReport[r._id.toString()]; %>
              <td>
                <% if (reqId) { %>
                <span class="badge <%= paymentStatusByReport[r._id.toString()] === 'paid' ? 'bg-success' : 'bg-warning text-dark' %>">
                  <%= paymentStatusByReport[r._id.toString()] === 'paid' ? 'Paid' : 'Pending' %>
                </span>
                <% } else { %><span class="text-muted small">—</span><% } %>
              </td>
              <td class="small text-muted"><%= new Date(r.createdAt).toLocaleDateString('en-IN') %></td>
              <td>
                <div class="d-flex gap-1 flex-wrap">
                  <a href="/employee/reports/<%= r._id %>" class="btn btn-sm btn-outline-secondary">View</a>
                  <% if (reqId) { %>
                  <a href="/employee/requests/<%= reqId %>/invoice" class="btn btn-sm btn-outline-dark" target="_blank">Invoice</a>
                  <% if (paymentStatusByReport[r._id.toString()] === 'paid') { %>
                  <form method="POST" action="/employee/reports/<%= r._id %>/send" style="display:inline">
                    <button class="btn btn-sm btn-success" type="submit">Send Report</button>
                  </form>
                  <% } %>
                  <% } %>
                </div>
              </td>
            </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
      <a href="/employee/reports" class="btn btn-sm btn-outline-dark mt-3">View all my reports →</a>
      <% } %>
    </div>
  </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
