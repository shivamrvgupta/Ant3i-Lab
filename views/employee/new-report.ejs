<!doctype html>
<html lang="en">
<head><%- include('../partials/head') %><title>New Report</title></head>
<body class="app-bg">
<%- include('../partials/navbar') %>

<div class="container-xxl py-4">
  <div class="d-flex align-items-center gap-3 mb-4">
    <a href="/employee/dashboard" class="btn btn-sm btn-outline-secondary">← Back</a>
    <h4 class="fw-bold mb-0">New Test Report</h4>
    <span class="badge bg-secondary font-monospace">Next No: <%= nextReportNo %></span>
  </div>

  <% if (error) { %>
    <div class="alert alert-danger py-2 small"><%= error %></div>
  <% } %>
  <% if (prefill) { %>
    <div class="alert alert-info py-2 small mb-1">
      Pre-filled from booking request — enter the actual test result values below.
    </div>
  <% } %>

  <form method="POST" action="/employee/reports">
    <div class="card border-0 rounded-4 shadow-sm mb-3">
      <div class="card-body">

        <!-- ── Basic Details ── -->
        <div class="section-label mt-1">Basic Details</div>
        <% if (prefill) { %><input type="hidden" name="fromRequestId" value="<%= prefill.fromRequestId %>"><% } %>

        <div class="position-relative mt-2">
          <label class="form-label small text-muted">Customer</label>
          <input class="form-control" id="customerInput" name="customer"
                 value="<%= prefill ? prefill.customer : '' %>"
                 placeholder="Type to search or add new..." autocomplete="off" required />
          <ul id="customerSuggestions" class="list-group position-absolute w-100 shadow-sm"
              style="z-index:999;display:none;max-height:200px;overflow-y:auto"></ul>
        </div>

        <div class="row g-2 mt-1">
          <div class="col-6 col-md-3">
            <label class="form-label small text-muted">Sample Name</label>
            <input class="form-control" name="sampleName" value="<%= prefill ? prefill.sampleName : 'DIESEL' %>" />
          </div>
          <div class="col-6 col-md-3">
            <label class="form-label small text-muted">Report Date</label>
            <input class="form-control" name="reportDate" type="date" value="<%= today %>" required />
          </div>
          <div class="col-6 col-md-3">
            <label class="form-label small text-muted">Date Received</label>
            <input class="form-control" name="dateReceived" type="date" value="<%= prefill ? prefill.dateReceived : today %>" />
          </div>
          <div class="col-6 col-md-3">
            <label class="form-label small text-muted">Fuel / Product Type</label>
            <select class="form-select" name="fuelType">
              <% fuelTypes.forEach(ft => { %>
              <option value="<%= ft.name %>"
                <%= (prefill && prefill.fuelType === ft.name) || (!prefill && ft.name === 'BS-VI Diesel (10 ppm)') ? 'selected' : '' %>>
                <%= ft.name %>
              </option>
              <% }) %>
            </select>
          </div>
        </div>

        <div class="row g-2 mt-1">
          <div class="col-6 col-md-4">
            <label class="form-label small text-muted">Sample ID</label>
            <input class="form-control" name="sampleId" value="<%= prefill ? prefill.sampleId : '' %>" placeholder="e.g. Seal No.-001343" />
          </div>
          <div class="col-6 col-md-4">
            <label class="form-label small text-muted">Packing Condition</label>
            <input class="form-control" name="packingCondition" value="<%= prefill ? prefill.packingCondition : '' %>" placeholder="e.g. Unsealed, 1L Aluminum Bottle" />
          </div>
          <div class="col-6 col-md-4">
            <label class="form-label small text-muted">Tested By</label>
            <input class="form-control" value="<%= user.name %>" disabled />
          </div>
        </div>

        <!-- ── Key Results (dynamic from catalog) ── -->
        <div class="section-label mt-4">Key Results</div>
        <div class="row g-2 mt-1">
          <% catalogItems.filter(c => c.code !== '1240' && c.code !== '1241').forEach(item => { %>
          <% (item.fields || []).filter(f => f.fieldName).forEach(f => { %>
          <div class="col-6 col-md-3">
            <label class="form-label small text-muted">
              <%= f.label || item.name %><% if (f.unit && f.unit !== '-') { %> (<%= f.unit %>)<% } %>
            </label>
            <% if (f.specType === 'text' || f.specType === 'visual') { %>
              <input class="form-control" name="<%= f.fieldName %>"
                     value="<%= f.specText || '' %>" />
            <% } else { %>
              <input class="form-control" name="<%= f.fieldName %>"
                     type="number" step="any" placeholder="—" />
            <% } %>
            <div class="form-text">
              <% if (f.specType === 'min')   { %>Min. <%= f.specMin %>
              <% } else if (f.specType === 'max')   { %>Max. <%= f.specMax %>
              <% } else if (f.specType === 'range') { %><%= f.specMin %>–<%= f.specMax %>
              <% } else if (f.specType === 'text' || f.specType === 'visual') { %><%= f.specText %>
              <% } %>
              <% const fMethod = f.method || item.method; if (fMethod) { %> · <%= fMethod %><% } %>
            </div>
          </div>
          <% }) %>
          <% }) %>
        </div>

        <!-- ── Distillation ── -->
        <% if (catalogItems.some(c => c.code === '1240')) { %>
        <div class="section-label mt-4">Distillation — Temperatures at % Recovery
          <span class="fw-normal text-muted small ms-1">· ASTM D 1550</span>
        </div>
        <div class="row g-2 mt-1">
          <% [['IBP','d_ibp'],['10%','d_10'],['50%','d_50'],['90%','d_90'],['95% (°C)','d_95'],['FBP','d_fbp']].forEach(([lbl,nm]) => { %>
          <div class="col-4 col-md-2">
            <label class="form-label small text-muted"><%= lbl %></label>
            <input class="form-control" name="<%= nm %>" type="number" step="any" placeholder="—" />
          </div>
          <% }) %>
          <div class="col-4 col-md-2">
            <label class="form-label small text-muted">Recovery %</label>
            <input class="form-control" name="d_recovery" placeholder="e.g. 97.2" />
          </div>
        </div>
        <div class="section-label mt-3" style="font-size:.75rem;text-transform:none;letter-spacing:0">
          Distillation Summary <span class="fw-normal text-muted ms-1">· ASTM D 86</span>
        </div>
        <div class="row g-2 mt-1">
          <div class="col-4 col-md-2">
            <label class="form-label small text-muted">Residue (%)</label>
            <input class="form-control" name="distResidue" placeholder="e.g. 1.5" />
          </div>
          <div class="col-4 col-md-2">
            <label class="form-label small text-muted">Loss (%)</label>
            <input class="form-control" name="distLoss" placeholder="e.g. 1.3" />
          </div>
        </div>
        <% } %>

        <div class="d-flex gap-2 mt-4">
          <button class="btn btn-dark" type="submit" id="submitBtn">Generate &amp; Save Report</button>
        </div>
        <div class="small text-muted mt-2">
          Report No. is auto-assigned. PDF will be emailed to the admin automatically.
        </div>
      </div>
    </div>
  </form>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script>
const input = document.getElementById('customerInput');
const list  = document.getElementById('customerSuggestions');
let debounce;
input.addEventListener('input', () => {
  clearTimeout(debounce);
  const q = input.value.trim();
  if (q.length < 1) { list.style.display = 'none'; return; }
  debounce = setTimeout(async () => {
    const res   = await fetch(`/api/customers/search?q=${encodeURIComponent(q)}`);
    const names = await res.json();
    list.innerHTML = '';
    if (!names.length) { list.style.display = 'none'; return; }
    names.forEach(name => {
      const li = document.createElement('li');
      li.className = 'list-group-item list-group-item-action py-1 small';
      li.textContent = name;
      li.addEventListener('mousedown', () => { input.value = name; list.style.display = 'none'; });
      list.appendChild(li);
    });
    list.style.display = 'block';
  }, 250);
});
document.addEventListener('click', e => { if (!input.contains(e.target)) list.style.display = 'none'; });

document.querySelector('form').addEventListener('submit', () => {
  const btn = document.getElementById('submitBtn');
  btn.disabled = true;
  btn.textContent = 'Generating…';
});
</script>
</body>
</html>
