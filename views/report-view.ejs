<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <title>Report <%= report.reportNo %></title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <% if (forPDF && inlineCSS) { %><style><%- inlineCSS %></style><% } else { %><link rel="stylesheet" href="/styles.css" /><% } %>
  <style>
    body { background: #f0f0f0; }
    .report-page {
      background: #fff;
      max-width: 900px;
      margin: 0 auto;
      padding: 28px 32px;
      font-size: 12.5px;
      font-family: Arial, sans-serif;
      color: #111;
    }
    .rpt-header {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      background: #fef9c3;
      border: 1.5px solid #d4a800;
      border-radius: 8px;
      padding: 14px 18px;
      margin-bottom: 10px;
      gap: 16px;
    }
    .rpt-title    { font-size: 18px; font-weight: 800; letter-spacing: .04em; }
    .rpt-subtitle { font-size: 11px; color: #555; margin-bottom: 8px; }
    .info-kv { display: flex; gap: 6px; font-size: 12px; margin-bottom: 3px; }
    .info-kv .lbl { color: #666; min-width: 100px; }
    .info-kv .val { font-weight: 600; }
    .status-boxes { display: flex; gap: 8px; flex-direction: column; align-items: flex-end; }
    .status-box {
      width: 110px; padding: 7px 0; text-align: center;
      font-weight: 700; font-size: 11px; border-radius: 6px;
      border: 2px solid; letter-spacing: .06em;
    }
    .status-box.urgent  { border-color: #dc2626; color: #dc2626; background: #fff5f5; }
    .status-box.caution { border-color: #d97706; color: #d97706; background: #fffbeb; }
    .status-box.normal  { border-color: #16a34a; color: #16a34a; background: #f0fdf4; }
    .status-box.urgent.active  { background: #dc2626; color: #fff; }
    .status-box.caution.active { background: #d97706; color: #fff; }
    .status-box.normal.active  { background: #16a34a; color: #fff; }
    .info-band {
      display: grid; grid-template-columns: repeat(4, 1fr);
      border: 1px solid #ccc; border-radius: 6px;
      overflow: hidden; margin-bottom: 10px;
    }
    .ib-cell { padding: 7px 10px; border-right: 1px solid #ccc; }
    .ib-cell:last-child { border-right: none; }
    .ib-label { font-size: 10px; color: #888; text-transform: uppercase; letter-spacing: .04em; margin-bottom: 2px; }
    .ib-val   { font-weight: 600; font-size: 12px; }
    .sec-heading {
      background: #374151; color: #fff;
      font-size: 11px; font-weight: 700;
      padding: 5px 10px; letter-spacing: .06em;
      text-transform: uppercase;
      border-radius: 4px 4px 0 0;
    }
    .params-table { width: 100%; border-collapse: collapse; font-size: 12px; }
    .params-table th {
      background: #f3f4f6; color: #374151;
      padding: 6px 8px; text-align: left;
      border: 1px solid #d1d5db; font-size: 11px; font-weight: 700;
    }
    .params-table td { padding: 5px 8px; border: 1px solid #e5e7eb; vertical-align: middle; }
    .params-table tbody tr:nth-child(even) { background: #fafafa; }
    .params-table .pass { color: #16a34a; font-weight: 800; }
    .params-table .fail { color: #dc2626; font-weight: 800; }
    .dist-wrap { display: grid; grid-template-columns: 190px 1fr; gap: 12px; margin-top: 8px; }
    .dist-table { width: 100%; border-collapse: collapse; font-size: 12px; }
    .dist-table th { background: #f3f4f6; padding: 5px 8px; border: 1px solid #d1d5db; font-size: 11px; font-weight: 700; }
    .dist-table td { padding: 4px 8px; border: 1px solid #e5e7eb; }
    .dist-table tbody tr:nth-child(even) { background: #fafafa; }
    .diagnosis-box {
      border: 1.5px solid #d1d5db; border-radius: 6px;
      padding: 12px 16px; margin-top: 10px; background: #fafafa;
    }
    .end-of-report { text-align: center; font-weight: 700; font-size: 13px; margin: 12px 0 4px; letter-spacing: .08em; }
    .signature-row { display: flex; justify-content: space-between; align-items: flex-end; margin-top: 14px; }
    .sig-block { text-align: center; font-size: 11.5px; }
    .sig-line  { border-top: 1px solid #555; width: 160px; margin: 0 auto 4px; }
    @media print {
      body { background:#fff !important; margin:0; padding:0; }
      .d-print-none { display: none !important; }
      .report-page   { padding: 6px 10px !important; max-width: 100% !important; font-size: 10px !important; }
      .rpt-header    { padding: 6px 10px !important; margin-bottom: 5px !important; gap: 10px !important; }
      .rpt-title     { font-size: 13px !important; }
      .rpt-subtitle  { font-size: 9px !important; margin-bottom: 3px !important; }
      .info-kv       { font-size: 9px !important; margin-bottom: 1px !important; }
      .info-kv .lbl  { min-width: 80px !important; }
      .status-box    { width: 82px !important; padding: 3px 0 !important; font-size: 8.5px !important; }
      .info-band     { margin-bottom: 5px !important; }
      .ib-cell       { padding: 3px 6px !important; }
      .ib-label      { font-size: 8px !important; margin-bottom: 1px !important; }
      .ib-val        { font-size: 9.5px !important; }
      .sec-heading   { padding: 3px 6px !important; font-size: 8.5px !important; }
      .params-table  { font-size: 9px !important; }
      .params-table th { padding: 2px 4px !important; font-size: 8.5px !important; }
      .params-table td { padding: 2px 4px !important; }
      .dist-table th, .dist-table td { padding: 2px 4px !important; font-size: 9px !important; }
      .dist-wrap     { gap: 6px !important; margin-top: 3px !important; }
      .diagnosis-box { padding: 5px 8px !important; margin-top: 5px !important; font-size: 9px !important; }
      .end-of-report { margin: 4px 0 2px !important; font-size: 10px !important; }
      .signature-row { margin-top: 5px !important; }
      .sig-block     { font-size: 9px !important; }
      #distChart     { height: 140px !important; }
      #viscChart, #flashChart { height: 80px !important; }
    }
    @media (max-width:640px) {
      .info-band { grid-template-columns: 1fr 1fr; }
      .dist-wrap { grid-template-columns: 1fr; }
      .status-boxes { flex-direction: row; }
    }
  </style>
</head>
<body>

  <% if (!forPDF) { %>
  <nav class="navbar navbar-dark bg-dark px-3 py-2 d-print-none">
    <span class="navbar-brand d-flex align-items-center gap-2 mb-0">
      <img src="/logo.png" alt="Logo" style="height:32px;width:auto;object-fit:contain" />
    </span>
    <div class="d-flex gap-2">
      <% if (user && user.role === 'admin') { %>
        <a href="/admin/reports"                        class="btn btn-sm btn-outline-light">← All Reports</a>
        <a href="/admin/reports/<%= report._id %>/edit"  class="btn btn-sm btn-outline-warning">Edit</a>
      <% } else { %>
        <a href="/employee/reports"                        class="btn btn-sm btn-outline-light">← My Reports</a>
        <a href="/employee/reports/<%= report._id %>/edit" class="btn btn-sm btn-outline-warning">Edit</a>
      <% } %>
      <button onclick="window.print()" class="btn btn-sm btn-outline-light">Print / PDF</button>
    </div>
  </nav>
  <div style="padding:20px 0">
  <% } %>

  <div class="report-page">
    <%
      function fmt(d) {
        if (!d) return '—';
        const dt = new Date(d);
        if (isNaN(dt)) return '—';
        return String(dt.getDate()).padStart(2,'0') + '/' +
               String(dt.getMonth()+1).padStart(2,'0') + '/' + dt.getFullYear();
      }
      const isNormal = report.overallStatus === 'NORMAL';
    %>

    <!-- HEADER -->
    <div class="rpt-header">
      <div>
        <div style="margin-bottom:8px">
          <img src="/logo.png" alt="Logo" style="height:48px;width:auto;object-fit:contain" />
        </div>
        <div class="rpt-title">TEST REPORT</div>
        <div class="rpt-subtitle">Diesel Quality Analysis &nbsp;|&nbsp; <%= report.specStd %></div>
        <div class="info-kv"><span class="lbl">Customer</span>     <span class="val">: <%= report.customer %></span></div>
        <div class="info-kv"><span class="lbl">Sample Name</span>  <span class="val">: <%= report.sampleName %></span></div>
        <div class="info-kv"><span class="lbl">Report No.</span>   <span class="val">: <%= report.reportNo %></span></div>
        <div class="info-kv"><span class="lbl">Report Date</span>  <span class="val">: <%= fmt(report.reportDate) %></span></div>
        <div class="info-kv"><span class="lbl">Tested By</span>    <span class="val">: <%= report.createdBy?.name || '—' %></span></div>
      </div>
      <div class="status-boxes">
        <div class="status-box urgent  <%= !isNormal ? 'active' : '' %>">&#9888; URGENT</div>
        <div class="status-box caution">&#9889; CAUTION</div>
        <div class="status-box normal  <%= isNormal  ? 'active' : '' %>"><%- isNormal ? '&#10003;' : '&#9675;' %> NORMAL</div>
      </div>
    </div>

    <!-- INFO BAND -->
    <div class="info-band">
      <div class="ib-cell">
        <div class="ib-label">Lab Number</div>
        <div class="ib-val"><%= report.reportNo %></div>
      </div>
      <div class="ib-cell">
        <div class="ib-label">Date Received</div>
        <div class="ib-val"><%= fmt(report.dateReceived) %></div>
      </div>
      <div class="ib-cell">
        <div class="ib-label">Sample ID</div>
        <div class="ib-val"><%= report.sampleId || '—' %></div>
      </div>
      <div class="ib-cell">
        <div class="ib-label">Packing Condition</div>
        <div class="ib-val"><%= report.packingCondition || '—' %></div>
      </div>
    </div>

    <!-- TEST PARAMETERS -->
    <%
      const viscParam  = report.params.find(p => p.name === 'Viscosity @ 40\u00b0C');
      const flashParam = report.params.find(p => p.name === 'Flash Point - (PMCC)');
      const viscValue  = (viscParam  && viscParam.value  !== null && viscParam.value  !== undefined) ? viscParam.value  : null;
      const flashValue = (flashParam && flashParam.value !== null && flashParam.value !== undefined) ? flashParam.value : null;
    %>
    <div style="display:grid;grid-template-columns:1fr 210px;gap:8px;align-items:start">
      <div>
        <div class="sec-heading">Test Parameters</div>
        <table class="params-table">
          <thead>
            <tr>
              <th style="width:30%">Test Parameter</th>
              <th style="width:14%">Method</th>
              <th style="width:20%">Specification (<%= report.specStd.split('(')[1] ? report.specStd.split('(')[1].replace(')','') : report.specStd %>)</th>
              <th style="width:11%">Units</th>
              <th style="width:11%">Results</th>
              <th style="width:14%">Comments</th>
            </tr>
          </thead>
          <tbody>
            <% report.params.forEach(p => { %>
            <tr>
              <td><%= p.name %></td>
              <td><%= p.method %></td>
              <td><%= p.spec %></td>
              <td><%= p.unit %></td>
              <td><strong><%= p.display %></strong></td>
              <td class="<%= p.statusOk ? 'pass' : 'fail' %>"><%= p.statusDisplay %></td>
            </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
      <div style="display:flex;flex-direction:column;gap:6px;padding-top:22px">
        <div style="border:1px solid #e5e7eb;border-radius:4px;padding:4px 4px 0">
          <canvas id="viscChart" style="width:100%;height:128px;display:block"></canvas>
          <div style="text-align:center;font-size:9.5px;color:#555;padding:2px 0 3px">Viscosity @ 40°C, cSt</div>
        </div>
        <div style="border:1px solid #e5e7eb;border-radius:4px;padding:4px 4px 0">
          <canvas id="flashChart" style="width:100%;height:128px;display:block"></canvas>
          <div style="text-align:center;font-size:9.5px;color:#555;padding:2px 0 3px">Flash Point - (PMCC)</div>
        </div>
      </div>
    </div>

    <!-- DISTILLATION -->
    <div class="sec-heading" style="margin-top:12px">Distillation And Graph (ASTM D86)</div>
    <div class="dist-wrap">
      <table class="dist-table">
        <thead>
          <tr><th>Volume in ml</th><th>Deg °C</th></tr>
        </thead>
        <tbody>
          <% report.distPoints.forEach(dp => { %>
          <tr>
            <td><%= dp.label %></td>
            <td><%= (dp.temp !== null && dp.temp !== undefined) ? dp.temp : '—' %></td>
          </tr>
          <% }) %>
        </tbody>
      </table>

      <div class="chart-wrap" style="padding:8px">
        <canvas id="distChart" style="width:100%;height:230px;display:block"></canvas>
      </div>
    </div>

    <!-- DIAGNOSIS -->
    <div class="diagnosis-box">
      <strong>COMMENTS:</strong>&nbsp;
      As per <strong><%= report.specStd %></strong> specification, the tested sample is found in
      <strong style="color:<%= isNormal ? '#16a34a' : '#dc2626' %>"><%= report.overallStatus %></strong> condition.<% if (!isNormal) { %>
      &nbsp;<span style="color:#dc2626">(<%= report.failCount %> parameter(s) out of specification)</span><% } %>
    </div>

    <div class="end-of-report">&#42;&#42;&#42; End of Report &#42;&#42;&#42;</div>

    <div class="signature-row">
      <div style="font-size:11px;color:#777">
        Generated: <%= new Date(report.createdAt).toLocaleString('en-IN') %><br>
        This report is for internal use. Verify against original lab COA when required.
      </div>
      <div class="sig-block">
        <div class="sig-line"></div>
        <div>Authorized Signatory</div>
      </div>
    </div>

  </div><!-- /report-page -->

  <% if (!forPDF) { %>
  </div>
  <% } %>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <% if (forPDF && inlineJS) { %><script><%- inlineJS %></script><% } else { %><script src="/chart.js"></script><% } %>
  <script>
    const distPoints = <%- JSON.stringify(report.distPoints) %>;
    const pts = distPoints.map(dp => [dp.label, dp.temp]);
    drawDistillation(pts);
    drawParamGauge('viscChart',  <%- JSON.stringify(viscValue)  %>, '#1a6fc4');
    drawParamGauge('flashChart', <%- JSON.stringify(flashValue) %>, '#dc2626');
    window.chartDrawn = true;
  </script>
</body>
</html>
