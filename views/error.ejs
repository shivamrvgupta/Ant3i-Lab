<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <title>Error</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="d-flex align-items-center justify-content-center" style="min-height:100vh;background:#f5f6f8">
  <div class="text-center">
    <div class="fs-1 fw-bold text-muted">Oops</div>
    <div class="mt-2 text-muted"><%= message %></div>
    <a href="javascript:history.back()" class="btn btn-outline-dark btn-sm mt-3">Go Back</a>
  </div>
</body>
</html>
